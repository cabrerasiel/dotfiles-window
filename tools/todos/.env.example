# Copiá este archivo a .env y completá tus propios valores.
# El .env real está ignorado por git (ver .gitignore) — nunca lo commitees.

# Dominio de tu instancia de Jira Cloud (sin https://)
JIRA_DOMAIN=tuempresa.atlassian.net

# Email con el que te logueás en Jira
JIRA_EMAIL=tu-email@ejemplo.com

# API token personal, generado en:
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
